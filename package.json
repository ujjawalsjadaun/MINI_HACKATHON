{
  "name": "uniseva-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Campus issue management: report, dedupe, prioritise, assign and track campus problems. A MERN monorepo (MongoDB, Express, React, Node).",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace @uniseva/frontend",
    "start": "npm run start --workspace @uniseva/backend",
    "seed": "npm run seed --workspace @uniseva/backend",
    "backup": "npm run backup --workspace @uniseva/backend",
    "restore": "npm run restore --workspace @uniseva/backend --",
    "test": "node --test test/*.test.js && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Ujjawal Singh",
  "contributors": [
    "Anirudh Mishra"
  ],
  "license": "MIT"
}
