# Copy this file to .env and fill it in. .env is never committed (it is in .gitignore).
# Used by docker-compose.yml; with plain "npm start" set the same names as environment variables.

# The MongoDB database. docker-compose.yml sets this for you; set it yourself with plain "npm start"
# (default mongodb://127.0.0.1:27017/uniseva) or for a hosted database such as MongoDB Atlas.
# MONGODB_URI=mongodb://127.0.0.1:27017/uniseva

# ---- Required on a real server ------------------------------------------------------------
# The first admin account, created the first time the site starts. The password must be private
# and at least 10 characters. After signing in, add staff on the People page.
ADMIN_EMAIL=admin@nitap.ac.in
ADMIN_PASSWORD=

# The public address of the site, used by the HTTPS proxy (docker-compose.yml) to get a certificate.
SITE_ADDRESS=issues.nitap.ac.in

# ---- Optional ---------------------------------------------------------------------------
# Days of backups to keep (one a day), and how often to take them (0 turns them off).
BACKUP_KEEP=14
BACKUP_EVERY_HOURS=24

# Create the demo students, staff and issues instead of only the admin. For demonstrations, never real use.
# SEED_DEMO=1

# Full emergency directory (names and personal numbers). Keep the file out of Git; see the README.
# EMERGENCY_FILE=/data/emergency-contacts.json
