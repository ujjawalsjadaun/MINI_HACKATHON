# Copy this file to .env (it is git-ignored) and fill it in. Nothing here is required to run the app.

# Password-reset emails. Without these, the email is printed in the server console (demo mode).
# Gmail example: turn on 2-step verification, then create an "App password" and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=CampusFix <you@gmail.com>

# Optional local model for Smart suggest (needs Ollama running on this computer).
# OLLAMA_MODEL=llama3.2
